<%- include('partials/head', { title: 'Create Account – PasskeyDemo' }) %>

  <body class="auth-page">
    <%- include('partials/bg-blobs') %>

      <div class="auth-card">
        <div class="auth-logo">
          <div class="logo-icon">
            <i data-lucide="shield-check"></i>
          </div>
          <h1>Create account</h1>
          <p class="subtitle">Join and set up passkey authentication</p>
        </div>

        <% if (error) { %>
          <div class="alert alert-error">
            <i data-lucide="alert-circle" class="alert-icon"></i>
            <%= error %>
          </div>
          <% } %>

            <form action="/register" method="POST" id="form-register" autocomplete="on">
              <div class="field">
                <label for="username">Username</label>
                <div class="input-wrap">
                  <i data-lucide="user" class="input-icon"></i>
                  <input id="username" name="username" type="text" autocomplete="username" placeholder="john_doe"
                    minlength="3" maxlength="64" required />
                </div>
              </div>
              <div class="field">
                <label for="email">Email address</label>
                <div class="input-wrap">
                  <i data-lucide="mail" class="input-icon"></i>
                  <input id="email" name="email" type="email" autocomplete="email" placeholder="you@example.com"
                    required />
                </div>
              </div>
              <div class="field">
                <label for="password">
                  Password <span class="label-hint">(optional. you can use passkeys only)</span>
                </label>
                <div class="input-wrap">
                  <i data-lucide="lock" class="input-icon"></i>
                  <input id="password" name="password" type="password" autocomplete="new-password"
                    placeholder="••••••••" />
                </div>
              </div>
              <button type="submit" class="btn btn-primary">
                <i data-lucide="user-plus" class="icon"></i>
                Create Account
              </button>
            </form>

            <p class="auth-switch">Already have an account? <a href="/login">Sign in</a></p>
      </div>
  </body>

  </html>