<%- include('partials/head', { title: 'Dashboard – PasskeyDemo' }) %>
<body class="dashboard-page">

  <!-- ── Navbar ───────────────────────────────────── -->
  <nav class="navbar">
    <div class="nav-brand">
      <i data-lucide="key-round" class="nav-logo-icon"></i>
      <span>PasskeyDemo</span>
    </div>
    <div class="nav-user">
      <span class="nav-username">
        <i data-lucide="user-circle" class="nav-user-icon"></i>
        <%= user.username %>
      </span>
      <form action="/logout" method="POST" style="display:inline">
        <button type="submit" class="btn btn-ghost btn-sm">
          <i data-lucide="log-out" class="icon"></i>
          Sign out
        </button>
      </form>
    </div>
  </nav>

  <!-- ── Main ─────────────────────────────────────── -->
  <main class="dashboard-main">

    <!-- Welcome card -->
    <section class="card welcome-card">
      <div class="welcome-text">
        <h2>Welcome, <strong><%= user.username %></strong>!</h2>
        <p>You are securely authenticated. Manage your passkeys below.</p>
      </div>
      <div class="welcome-meta">
        <div class="meta-item">
          <span class="meta-label">Email</span>
          <span class="meta-value"><%= user.email %></span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Member since</span>
          <span class="meta-value"><%= new Date(user.createdAt).toLocaleDateString() %></span>
        </div>
        <div class="meta-item">
          <span class="meta-label">Password</span>
          <span class="meta-value badge <%= user.password ? 'badge-green' : 'badge-gray' %>">
            <%= user.password ? 'Set' : 'Not set' %>
          </span>
        </div>
      </div>
    </section>

    <!-- Passkeys section -->
    <section class="card passkeys-card">
      <div class="section-header">
        <div>
          <h3>Your Passkeys</h3>
          <p class="section-sub"><%= passkeys.length %> passkey<%= passkeys.length !== 1 ? 's' : '' %> registered</p>
        </div>
        <button id="btn-add-passkey" class="btn btn-primary btn-sm">
          <i data-lucide="plus" class="icon"></i>
          Add Passkey
        </button>
      </div>

      <!-- Alert area -->
      <div id="alert-area"></div>

      <!-- Passkey list -->
      <% if (passkeys.length === 0) { %>
        <div class="passkeys-empty">
          <div class="empty-illustration">
            <i data-lucide="shield-off"></i>
          </div>
          <p>No passkeys yet. Add one to enable passwordless sign-in.</p>
        </div>
      <% } else { %>
        <ul class="passkeys-list" id="passkeys-list">
          <% passkeys.forEach(pk => { %>
            <li class="passkey-item" id="pk-<%= pk._id %>">
              <div class="passkey-icon-wrap">
                <i data-lucide="key-round"></i>
              </div>
              <div class="passkey-info">
                <span class="passkey-name" id="pk-name-<%= pk._id %>"><%= pk.deviceName %></span>
                <span class="passkey-meta">
                  Added <%= new Date(pk.createdAt).toLocaleDateString() %>
                  <% if (pk.lastUsedAt) { %>
                    &middot; Last used <%= new Date(pk.lastUsedAt).toLocaleDateString() %>
                  <% } %>
                </span>
              </div>
              <div class="passkey-actions">
                <button
                  class="btn btn-ghost btn-xs"
                  onclick="renamePasskey('<%= pk._id %>', '<%= pk.deviceName %>')"
                  title="Rename passkey"
                >
                  <i data-lucide="pencil" class="icon"></i>
                  Rename
                </button>
                <button
                  class="btn btn-danger btn-xs"
                  onclick="deletePasskey('<%= pk._id %>')"
                  title="Remove passkey"
                >
                  <i data-lucide="trash-2" class="icon"></i>
                  Remove
                </button>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>

  </main>

  <!-- Add-Passkey modal -->
  <div id="modal-overlay" class="modal-overlay hidden">
    <div class="modal">
      <div class="modal-header">
        <h3>
          <i data-lucide="fingerprint" class="modal-title-icon"></i>
          Register a New Passkey
        </h3>
        <button class="modal-close" id="btn-modal-close" aria-label="Close">
          <i data-lucide="x"></i>
        </button>
      </div>
      <div class="modal-body">
        <div class="field">
          <label for="device-name">Device name</label>
          <div class="input-wrap">
            <i data-lucide="monitor-smartphone" class="input-icon"></i>
            <input
              id="device-name"
              type="text"
              placeholder="e.g. MacBook Pro, iPhone 15"
              maxlength="64"
            />
          </div>
          <small>A friendly label so you can identify this passkey later.</small>
        </div>
      </div>
      <div class="modal-footer">
        <button id="btn-cancel-passkey" class="btn btn-ghost">Cancel</button>
        <button id="btn-confirm-passkey" class="btn btn-primary">
          <i data-lucide="shield-plus" class="icon"></i>
          Register Passkey
        </button>
      </div>
    </div>
  </div>

  <script type="module" src="/js/passkey-register.js"></script>
</body>
</html>
