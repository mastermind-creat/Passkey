# Passkey Authentication – Node.js / Express / EJS
# Copy this file to .env and fill in your values

PORT=3000

# Supabase project URL and service-role key (server-side only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Postgres connection string; use the Session pooler for hosted deployments
DATABASE_URL=postgresql://postgres.[project-ref]:your-database-password@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# Session secret – use a long random string in production
SESSION_SECRET=replace_with_at_least_32_random_bytes

# Your app's public origin (scheme + host + optional port)
# Must match exactly what the browser sees
RP_ORIGIN=http://localhost:3000

# Relying Party name (shown to user in the browser passkey dialog)
RP_NAME=PasskeyDemo

# Relying Party ID – the effective domain (no port, no scheme)
RP_ID=localhost
